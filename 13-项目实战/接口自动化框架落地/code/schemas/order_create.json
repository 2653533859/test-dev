{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": { "type": "number" },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["orderId", "status", "payAmount"],
      "properties": {
        "orderId": { "type": "string" },
        "status": { "type": "string" },
        "payAmount": { "type": "number" }
      }
    }
  }
}
